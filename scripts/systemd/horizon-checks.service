[Unit]
Description=Horizon isolated validation broker (fixed checks only)
After=docker.service
Requires=docker.service
[Service]
Type=simple
WorkingDirectory=/opt/horizon-agent-control-20261101
ExecStart=/usr/bin/python3 -m horizon_core.check_service
Restart=on-failure
RuntimeDirectory=horizon-checks
RuntimeDirectoryMode=0755
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/horizon-worker/projects /var/lib/horizon-worker/workspace /run/horizon-checks /tmp
UMask=0022
[Install]
WantedBy=multi-user.target
